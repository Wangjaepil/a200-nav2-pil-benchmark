<?xml version="1.0" ?>
<sdf version="1.9">

  <world name="benchmark">

    <!-- Physics -->
    <physics name="physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Gazebo Harmonic systems -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- S5 dynamic-obstacle collision ground truth.  Dynamic models carry
         their own contact sensor + TouchPlugin; this world system services
         those sensors.  It is inert for S1-S4 worlds without contact sensors. -->
    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact"/>

    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu"/>

    <plugin
      filename="gz-sim-navsat-system"
      name="gz::sim::systems::NavSat"/>

    <!-- GPS 기준 좌표 -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>37.0</latitude_deg>
      <longitude_deg>126.0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- 화면 -->
    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.4 0.6 0.8 1</background>
      <shadows>false</shadows>
      <grid>true</grid>
    </scene>

    <!-- 태양 -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ================================ -->
    <!-- 200 m x 200 m Benchmark Ground -->
    <!-- ================================ -->
    <model name="benchmark_ground">
      <static>true</static>

      <!-- 윗면이 z=0이 되도록 배치 -->
      <pose>0 0 -0.05 0 0 0</pose>

      <link name="ground_link">

        <collision name="collision">
          <geometry>
            <box>
              <size>200 200 0.1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>200 200 0.1</size>
            </box>
          </geometry>

          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

  </world>

</sdf>
