<root BTCPP_format="4" main_tree_to_execute="MainTree">

  <BehaviorTree ID="MainTree">

    <RecoveryNode number_of_retries="4" name="NavigateRecovery">

      <!-- ========================= -->
      <!-- 정상 Navigation -->
      <!-- ========================= -->
      <PipelineSequence name="NavigateWithReplanning">

        <!--
          5 Hz로 Planner를 돌리는 것이 아니라
          기존 Global Path를 계속 사용할 수 있는지 검사한다.

          정상 상태에서는 유효한 경로를 최대 5초까지 유지한다.
          단, Predictive Safety가 횡단 동적 장애물의 통과 완료를 판단하면
          그 이벤트보다 최신 Global Costmap이 도착한 직후 1회 재계획한다.
        -->
        <RateController hz="5.0">

          <RecoveryNode number_of_retries="1"
                        name="ComputePathToPose">

            <!-- ========================= -->
            <!-- 정상 Planner 동작 -->
            <!-- ========================= -->
            <ReactiveFallback name="ReplanOnlyIfNeeded">

              <!-- 기존 Global Path 유지 조건 -->
              <ReactiveSequence name="KeepCurrentPath">

                <!--
                  평상시에는 5초 주기 재계획.
                  동적 장애물이 완전히 통과한 경우에는 PredictiveReplan이
                  최신 Global Costmap을 확인한 뒤 즉시 1회 재계획을 요청한다.

                  PredictiveReplan은 새 Path가 blackboard에 반영될 때까지
                  SUCCESS를 유지해 ReactiveFallback이 실행 중인
                  ComputePathToPose를 다음 BT tick에서 취소하지 않게 한다.
                -->
                <Inverter>
                  <Fallback name="PeriodicOrPassedObstacleReplan">
                    <PredictiveReplan
                      path="{path}"
                      state_topic="/predictive_collision_state"
                      costmap_topic="/global_costmap/costmap"
                      event_timeout_sec="2.0"/>
                    <PathExpiringTimer seconds="5.0" path="{path}"/>
                  </Fallback>
                </Inverter>

                <!-- 새로운 goal / sub-goal이 아니어야 함 -->
                <Inverter>
                  <GlobalUpdatedGoal/>
                </Inverter>

                <!-- 기존 Path가 Global Costmap에서 유효해야 함 -->
                <IsPathValid path="{path}"/>

              </ReactiveSequence>


              <!--
                아래 조건 중 하나면 A* 재계획:
                  1) 새로운 Goal / sub-goal
                  2) 기존 Path invalid
                  3) 유효한 Path도 5초 경과
                  4) 동적 장애물 통과 완료 + 최신 Global Costmap 확인

                실패 원인은
                {compute_path_error_code}에 저장
              -->
              <ComputePathToPose
                goal="{goal}"
                path="{path}"
                planner_id="GridBased"
                error_code_id="{compute_path_error_code}"/>

            </ReactiveFallback>


            <!-- ========================= -->
            <!-- Planner Context Recovery -->
            <!-- ========================= -->
            <!--
              Planner 실패라고 무조건 Clear하지 않음.

              해당 오류가 Planner Recovery로
              복구할 가치가 있는 오류일 때만
              Global Costmap Clear 실행.
            -->
            <Sequence name="PlannerContextRecovery">

              <WouldAPlannerRecoveryHelp
                error_code="{compute_path_error_code}"/>

              <ClearEntireCostmap
                name="ClearGlobalCostmap-Context"
                service_name="global_costmap/clear_entirely_global_costmap"/>

            </Sequence>

          </RecoveryNode>

        </RateController>


        <!-- ========================= -->
        <!-- Local Controller -->
        <!-- ========================= -->
        <RecoveryNode number_of_retries="1"
                      name="FollowPath">

          <!--
            DWB / Controller 실패 원인은
            {follow_path_error_code}에 저장
          -->
          <FollowPath
            path="{path}"
            controller_id="FollowPath"
            error_code_id="{follow_path_error_code}"/>


          <!-- ========================= -->
          <!-- Controller Context Recovery -->
          <!-- ========================= -->
          <Sequence name="ControllerContextRecovery">

            <WouldAControllerRecoveryHelp
              error_code="{follow_path_error_code}"/>

            <ClearEntireCostmap
              name="ClearLocalCostmap-Context"
              service_name="local_costmap/clear_entirely_local_costmap"/>

          </Sequence>

        </RecoveryNode>

      </PipelineSequence>


      <!-- ========================= -->
      <!-- System Recovery -->
      <!-- ========================= -->

      <!--
        Navigation이 실패했다고 무조건
        BackUp / Wait 하지 않는다.

        Planner 또는 Controller 오류 중
        Recovery가 도움될 가능성이 있는 오류인 경우에만
        System Recovery 진입.
      -->
      <Sequence name="SystemRecoveryIfUseful">

        <Fallback name="RecoveryErrorFilter">

          <WouldAControllerRecoveryHelp
            error_code="{follow_path_error_code}"/>

          <WouldAPlannerRecoveryHelp
            error_code="{compute_path_error_code}"/>

        </Fallback>


        <ReactiveFallback name="RecoveryFallback">

          <!--
            far_goal_manager가 새로운 sub-goal을 보내면
            현재 recovery 중단 후 새 goal 처리
          -->
          <GoalUpdated/>


          <RoundRobin name="RecoveryActions">

            <!--
              현재 Phase 4 임시 Recovery.
              이후 AdaptiveEscape로 교체 예정.
            -->
            <BackUp
              backup_dist="0.30"
              backup_speed="0.10"
              time_allowance="6.0"/>

            <Wait
              wait_duration="3.0"/>

          </RoundRobin>

        </ReactiveFallback>

      </Sequence>

    </RecoveryNode>

  </BehaviorTree>

</root>
